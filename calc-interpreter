"""Tiny expression interpreter: tokeniser -> recursive-descent parser -> AST -> evaluator.
Supports + - * / ** %, unary minus, parentheses, variables and assignment.
Run `python calc.py` for a REPL, or `python -m unittest calc` for the tests.
"""
import re
import unittest
from dataclasses import dataclass
TOKEN_RE = re.compile(r"\s*(?:(\d+\.?\d*)|([A-Za-z_]\w*)|(\*\*|[-+*/%()=]))")

class CalcError(Exception):
pass

@dataclass
class Num:
value: float

@dataclass
class Var:
name: str

@dataclass
class Unary:
op: str
operand: object

@dataclass
class Binary:
op: str
left: object
right: object

@dataclass
class Assign:
name: str
value: object

def tokenise(src):
tokens, pos = [], 0
while pos < len(src):
if src[pos:].strip() == "":
break
m = TOKEN_RE.match(src, pos)
if not m:
raise CalcError(f"Unexpected character {src[pos:].strip()[0]!r} at position {pos}")
num, ident, op = m.groups()
tokens.append(("num", float(num)) if num else ("id", ident) if ident else ("op", op))
pos = m.end()
return tokens

class Parser:
def __init__(self, tokens):
self.t, self.i = tokens, 0
def peek(self):
return self.t[self.i] if self.i < len(self.t) else (None, None)
def eat(self, op=None):
kind, val = self.peek()
if kind is None or (op and val != op):
raise CalcError(f"Expected {op!r}" if op else "Unexpected end of input")
self.i += 1
return kind, val
def parse(self):
node = self.statement()
if self.i != len(self.t):
raise CalcError(f"Unexpected token {self.peek()[1]!r}")
return node
def statement(self):
if (len(self.t) > 1 and self.t[0][0] == "id" and self.t[1] == ("op", "=")):
name = self.eat()[1]
self.eat("=")
return Assign(name, self.expr())
return self.expr()
def expr(self):
node = self.term()
while self.peek() in (("op", "+"), ("op", "-")):

node = Binary(self.eat()[1], node, self.term())
return node
def term(self):
node = self.unary()
while self.peek() in (("op", "*"), ("op", "/"), ("op", "%")):
node = Binary(self.eat()[1], node, self.unary())
return node
def unary(self):
if self.peek() == ("op", "-"):
self.eat()
return Unary("-", self.unary())
return self.power()
def power(self):
base = self.atom()
if self.peek() == ("op", "**"):
self.eat()
return Binary("**", base, self.unary()) # right-associative
return base
def atom(self):
kind, val = self.eat()
if kind == "num":
return Num(val)
if kind == "id":
return Var(val)
if val == "(":
node = self.expr()
self.eat(")")
return node
raise CalcError(f"Unexpected token {val!r}")

OPS = {
"+": lambda a, b: a + b, "-": lambda a, b: a - b, "*": lambda a, b: a * b,
"/": lambda a, b: a / b, "%": lambda a, b: a % b, "**": lambda a, b: a ** b,
}

def evaluate(node, env):
if isinstance(node, Num):
return node.value
if isinstance(node, Var):
if node.name not in env:

raise CalcError(f"Undefined variable {node.name!r}")
return env[node.name]
if isinstance(node, Unary):
return -evaluate(node.operand, env)
if isinstance(node, Assign):
env[node.name] = evaluate(node.value, env)
return env[node.name]
try:
return OPS[node.op](evaluate(node.left, env), evaluate(node.right, env))
except ZeroDivisionError:
raise CalcError("Division by zero")

def run(src, env=None):
return evaluate(Parser(tokenise(src)).parse(), {} if env is None else env)

class Tests(unittest.TestCase):
def test_precedence(self):
self.assertEqual(run("2 + 3 * 4"), 14)
self.assertEqual(run("(2 + 3) * 4"), 20)
def test_power_right_assoc(self):
self.assertEqual(run("2 ** 3 ** 2"), 512)
self.assertEqual(run("-2 ** 2"), -4)
def test_variables(self):
env = {}
run("x = 5", env)
self.assertEqual(run("x * 2", env), 10)
def test_errors(self):
for bad in ("1 +", "(1", "y", "1 / 0", "2 $ 3"):
with self.assertRaises(CalcError):
run(bad)

if __name__ == "__main__":
env = {}
while True:
try:
line = input("> ")
except EOFError:
break
if line.strip():
try:

print(run(line, env))
except CalcError as e:
print(f"Error: {e}")
